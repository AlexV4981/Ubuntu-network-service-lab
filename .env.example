DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_GUILD_ID=replace_with_your_server_id
MC_CONTROL_ROLE_ID=replace_with_your_control_role_id

# Match the Linux user that owns the project directory (id -u and id -g).
UID=1000
GID=1000

# Set these to your existing host log directories before starting ingestion.
MC_COBBLEMON_LOG_DIR=./minecraft/mc-cobblemon/logs
MC_HORROR_LOG_DIR=./minecraft/mc-horror/logs
